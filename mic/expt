add dont-require-permissions=no name=wan_ataka owner=admini policy=\
    ftp,reboot,read,write,policy,test,password,sniff,sensitive,romon source="# Script for blocking dangerous\
    \_addresses that tried to connect to the router\r\
    \n# https://forummikrotik.ru/viewtopic.php\?p=70410#p70410\r\
    \n# tested on ROS 6.46.5\r\
    \n# updated 2020/05/10\r\
    \n\r\
    \n:local dangerStrings [ /log find message~\"login failure for user \"; ];\r\
    \n       :local routerUsers [ /user get number=0 name ];\r\
    \n       foreach dangerString in=\$dangerStrings do={\r\
    \n           do {\r\
    \n               :local stringTemp ([ /log get \$dangerString message ]);\r\
    \n               :local dangerUser ([ :pick \$stringTemp 23 ([ :find \$stringTemp \"from\" ] - 1) ]);\r\
    \n               :local dangerIP ([ :pick \$stringTemp ([ :find \$stringTemp \"from\" ] + 5) ([ :find \$\
    stringTemp \"via\" ] - 1) ]);\r\
    \n               foreach routerUser in=\$routerUsers do={\r\
    \n                   do {\r\
    \n                       if ( \$routerUser != \$dangerUser ) do={\r\
    \n                           if ([ /ip firewall address-list find address=\$dangerIP ] = \"\" ) do={ \r\
    \n                               /ip firewall address-list add address=\$dangerIP list=\"blocklist\";\r\
    \n                               :log warning (\">>> Added in black list user: \".\$dangerUser.\" from I\
    P \".\$dangerIP);\r\
    \n                           } \r\
    \n                       }\r\
    \n                   } on-error={ :log warning \">>> Script error. Not found active router user.\"; } \r\
    \n               }\r\
    \n           } on-error={ :log warning \">>> Script error. Not found danger user in log.\"; }\r\
    \n       }\r\
    \n"
